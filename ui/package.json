{
  "name": "@whatsapp/ui",
  "version": "0.0.0",
  "description": "Shared WhatsApp message components for Frappe apps",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./Messages": {
      "import": "./src/components/Messages/index.ts",
      "types": "./src/components/Messages/index.ts"
    },
    "./utils": {
      "import": "./src/utils/index.ts",
      "types": "./src/utils/index.ts"
    },
    "./vite": {
      "import": "./vite/index.js"
    },
    "./*": {
      "import": "./src/*"
    }
  },
  "files": [
    "src",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frappe/whatsapp.git"
  },
  "author": "Frappe Technologies Pvt. Ltd.",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.0"
  },
  "peerDependencies": {
    "frappe-ui": ">=1.0.0-beta.16",
    "vue": ">=3.3.0"
  }
}
